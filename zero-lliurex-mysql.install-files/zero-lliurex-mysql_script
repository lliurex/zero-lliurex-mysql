#!/bin/bash

ACTION="$1"

shift

PACKAGE_LIST=$@

# START Define variables
MYSQL_MAJOR_RELEASE=9.7
MYSQL_RELEASE=${MYSQL_MAJOR_RELEASE}.4
MYSQL_URL="https://dev.mysql.com/get/Downloads/MySQL-${MYSQL_MAJOR_RELEASE}/mysql-${MYSQL_RELEASE}-linux-glibc2.28-x86_64-minimal.tar.xz"
MYSQL_INSTALL_FILES="/usr/share/zero-lliurex-mysql/mysql.install"
MYSQL_INSTALL_DIR=""
DEST_DIR="/opt"
# END Define Variables

function _getStatus
{
	INSTALLED=1
	if [[ " ${PACKAGE_LIST[*]} " == *" workbench "* ]]; then
		if snap list mysql-workbench-community >/dev/null 2>&1 ;then
			INSTALLED=0
		fi
	elif [[ " ${PACKAGE_LIST[*]} " == *" mysql "* ]]; then
			if [ -e $MYSQL_INSTALL_FILES ]; then
				MYSQL_INSTALL_DIR=$(head -n1 $MYSQL_INSTALL_FILES)
				MYSQL_INSTALL_DIR=${MYSQL_INSTALL_DIR/\/*/}
				MYSQL_INSTALL_DIR=${DEST_DIR}/${MYSQL_INSTALL_DIR}
				[ -e $MYSQL_INSTALL_DIR ] && INSTALLED=0
			fi
	fi
	echo $INSTALLED
}


case $ACTION in

	getStatus)
		_getStatus
	;;

	preInstall)
		if [[ " ${PACKAGE_LIST[*]} " == *" mysql "* ]]; then
			apt-cache show libaio1t64 1>/dev/null 2>&1 && apt-get -y install libaio1t64 || apt-get install -y libaio1 
		fi
	;;

	installPackage)
			if [[ " ${PACKAGE_LIST[*]} " == *" mysql "* ]]; then
				f=$(mktemp --suffix=.tar.xz)
				fname=$(basename $f)
				/usr/share/zero-lliurex-mysql/mysql-downloader.py $f $MYSQL_URL
				d=$(mktemp -d)
				mv $f ${d}/${fname}
				cd $d
				tar -Jxvf $fname > $MYSQL_INSTALL_FILES
				MYSQL_DIR=$(head -n1 $MYSQL_INSTALL_FILES | grep -o mysql.*)
				MYSQL_DIR=${MYSQL_DIR/\/*/}
				USER_NAME=$(id -un $PKEXEC_UID)
				mv -v $MYSQL_DIR $DEST_DIR
				#MySQL needs libaio.so.1 but in noble the lib is libaio.so.1t64
				#fix with a deferenced copy
				[ -e /lib/x86_64-linux-gnu/libaio.so.1t64 ] && cp -L /lib/x86_64-linux-gnu/libaio.so.1t64 $DEST_DIR/$MYSQL_DIR/lib/private/libaio.so.1
				cp /usr/share/zero-lliurex-mysql/mysqlrun /usr/bin
				sed -i "s/\[\[MYSQL_RELEASE\]\]/$(basename $MYSQL_DIR)/" /usr/bin/mysqlrun
				desktop-file-install /usr/share/zero-lliurex-mysql/mysqlrun.desktop
				echo " * * Finished * * "
				echo " **********************************************************"
				echo " *################### MYSQL INSTALLED ####################*"
				echo " »»                Execute MySQL from menu               ««" 
				echo " **********************************************************"
			fi
			if [[ " ${PACKAGE_LIST[*]} " == *" workbench "* ]]; then
				echo "****Installing Workbench... please wait****"
				snap install mysql-workbench-community
				#Key permissions
				sudo snap connect mysql-workbench-community:password-manager-service :password-manager-service
				#Print permissions
				sudo snap connect mysql-workbench-community:cups-control
				#Just in case, enable ssh connections
				sudo snap connect mysql-workbench-community:ssh-keys
			fi
	;;

	remove)
		for ix in $PACKAGE_LIST	
		do
			if [[ " $ix " == *" workbench "* ]]; then
				if snap list mysql-workbench-community >/dev/null 2>&1 ;then
					echo "**** Unstalling Workbench... please wait ****"
					snap remove mysql-workbench-community
				fi
			fi
			if [[ " $ix " == *" mysql "* ]]; then
				echo "**** Uninstalling MySQL $MYSQL_RELEASE... please wait ****"
				_getStatus
				if [ $INSTALLED -eq 0 ]; then
					LOCAL_MYSQL=${DEST_DIR}/$(basename $MYSQL_INSTALL_DIR)
					[[ $MYSQL_INSTALL_DIR == $LOCAL_MYSQL ]] && rm -vfr $MYSQL_INSTALL_DIR
					rm /usr/share/applications/mysqlrun.desktop
					rm /usr/bin/mysqlrun
				fi
			fi
		done
		echo " * * Finished * * "
	;;
esac

exit 0
