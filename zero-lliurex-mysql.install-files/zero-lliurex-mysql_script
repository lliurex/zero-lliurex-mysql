#!/bin/bash

ACTION="$1"

shift

PACKAGE_LIST=$@

# START Define variables
DESTDOWNLOAD="/var/cache/epi-downloads"
MYSQL_RELEASE=8.0
# END Define Variables



case $ACTION in

	getStatus)
			if [[ " ${PACKAGE_LIST[*]} " == *" workbench "* ]]; then
				if snap list mysql-workbench-community >/dev/null 2>&1 ;then
					echo 0
				else
					echo 1
				fi


			if [[ " ${PACKAGE_LIST[*]} " == *" mysql "* ]]; then
					if [ -n "$(docker images -q mysql:${MYSQL_RELEASE})" ]; then
						echo 0
					else
						echo 1
					fi
				else
					echo 1
				fi
			fi
	;;

	installPackage)

			if [[ " ${PACKAGE_LIST[*]} " == *" mysql "* ]]; then
				echo "****Installing MySQL $MYSQL_RELEASE docker... please wait****"
				docker image pull mysql:$MYSQL_RELEASE 
				inst="$(docker ps -a -q -f ancestor=mysql:$MYSQL_RELEASE)"
				if [ -n "${inst}" ]; then
					docker rm -f "${inst}"
				fi
				#cp /usr/share/zero-lliurex-mysql/odoo.desktop /usr/share/applications/
				#cp /usr/share/zero-lliurex-mysql/odoo.png /usr/share/icons
				#cp /usr/share/zero-lliurex-mysql/odoorun /usr/bin/odoorun
				#cp /usr/share/zero-lliurex-mysql/net.lliurex.odoorun.policy /usr/share/polkit-1/actions/
				#chmod +x /usr/bin/odoorun
				systemctl restart polkit
				echo " * * Finished * * "
				echo " **********************************************************"
				echo " *################### MYSQL INSTALLED ####################*"
				echo " **********************************************************"
			fi
			if [[ " ${PACKAGE_LIST[*]} " == *" workbench "* ]]; then
				echo "****Installing Workbench... please wait****"
				snap install mysql-workbench-community
			fi
	;;

	remove)
		for ix in $PACKAGE_LIST	

		do
			if [[ " $ix " == *" workbench "* ]]; then
				if snap list mysql-workbench-community >/dev/null 2>&1 ;then
					echo "****Unstalling Workbench... please wait****"
					snap remove mysql-workbench-community
					echo " * * Finished * * "
				fi
			fi
			if [[ " $ix " == *" mysql "* ]]; then
				echo "****Uninstalling MySQL $MYSQL_RELEASE docker... please wait****"
				inst="$(docker ps -a -q -f ancestor=mysql)"
				if [ -n "${inst}" ]; then
					docker rm -f "${inst}"
				fi
				imgs="$(docker images -q mysql:$MYSQL_RELEASE)"
				if [ -n "${imgs}" ];then
					docker rmi "${imgs}"
				fi
				#rm -f /usr/bin/odoorun
				#rm -f /usr/share/polkit-1/actions/net.lliurex.odoorun.policy
				systemctl restart polkit
				echo " * * Finished * * "
			fi
		done
	;;
esac

exit 0
