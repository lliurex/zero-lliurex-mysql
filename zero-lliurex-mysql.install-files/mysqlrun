#!/usr/bin/env python3
try:
	from PySide2.QtWidgets import QApplication,QTextEdit,QMainWindow,QPushButton,QGridLayout,QWidget,QComboBox
	from PySide2.QtGui import QIcon
	from PySide2.QtCore import QProcess,Signal
except:
	from PySide6.QtWidgets import QApplication,QTextEdit,QMainWindow,QPushButton,QGridLayout,QWidget,QComboBox
	from PySide6.QtGui import QIcon
	from PySide6.QtCore import QProcess,Signal
import os,sys,time,shutil
import gettext
gettext.textdomain('mysqlrun')
_ = gettext.gettext

class mysqlManager(QMainWindow):
	def __init__(self):
		super().__init__()
		self.setWindowTitle("MySQL Manager")
		icn=QIcon("/usr/share/zero-lliurex-mysql/mysql.png")
		self.setWindowIcon(icn)
		self.workbench=QProcess(self)
		self.process=QProcess(self)
		self.process.readyReadStandardOutput.connect(self._readOutput)
		self.process.readyReadStandardError.connect(self._readOutput)
		self.process.finished.connect(self._processEnd)
		self.process.started.connect(self._processStart)
		env=QProcess.systemEnvironment()
		env.append("LD_LIBRARY_PATH=/opt/mysql-9.7.4-linux-glibc2.28-x86_64-minimal/lib")
		self.process.setEnvironment(env)
		wdg=self._renderGui()
		self.setCentralWidget(wdg)
	#def __init__(self):

	def closeEvent(self,event):
		self._stopServer()
		event.accept()
		self.close()
	#def closeEvent

	def _renderGui(self,*args):
		wdg=QWidget()
		lay=QGridLayout(wdg)
		self.txtOutput=QTextEdit()
		self.txtOutput.setReadOnly(True)
		lay.addWidget(self.txtOutput,0,0,1,3)
		self.btnStop=QPushButton(_("Stop"))
		icn=QIcon.fromTheme("process-stop")
		self.btnStop.setIcon(icn)
		self.btnStop.clicked.connect(self._stopServer)
		lay.addWidget(self.btnStop,1,0,1,1)
		self.btnStart=QPushButton(_("Start"))
		self.btnStart.clicked.connect(self._runServer)
		icn=QIcon.fromTheme("system-run")
		self.btnStart.setIcon(icn)
		lay.addWidget(self.btnStart,1,1,1,1)
		self.cmbTools=QComboBox()
		self.cmbTools.setPlaceholderText("Utils")
		self.cmbTools.addItem("mysqld_safe")
		self.cmbTools.addItem("mysqld_initialize")
		self.cmbTools.activated.connect(self._launchCmd)
		lay.addWidget(self.cmbTools,1,2,1,1)
		btnWrk=QPushButton(_("Workbench"))
		btnWrk.clicked.connect(self._launchWorkbench)
		lay.addWidget(btnWrk,2,0,1,3)
		return(wdg)
	#def _renderGui

	def _readOutput(self):
		output=self.process.readAllStandardOutput().data().decode()
		self.txtOutput.append(output.strip())
		error=self.process.readAllStandardError().data().decode()
		self.txtOutput.append(error.strip())
	#def _readOutput

	def _launchWorkbench(self):
		self.workbench.start("snap",["run","mysql-workbench-community"])
	#def _launchWorkbench

	def _launchCmd(self,*args):
		cmd=self.cmbTools.currentText()
		binDir=_getBinDir()
		dataDir=_getDataDir()
		mysqld="{0}/{1}".format(binDir,cmd)
		if cmd=="mysqld_safe":
			cmdArgs=["--datadir={}".format(dataDir),"--persisted-globals-load"]
			self.process.start(mysqld,cmdArgs)
		else:
			cmd="mysqld"
			cmdArgs=["--datadir",dataDir,"--persisted-globals-load"]
			mysqld="{0}/{1}".format(binDir,cmd)
			if os.path.exists(dataDir):
				shutil.rmtree(dataDir)
			os.makedirs(dataDir)
			self._initServer(mysqld,cmdArgs)
	#def _launchCmd

	def _processStart(self,*args):
		self.cmbTools.setEnabled(False)
		self.btnStart.setEnabled(False)
		self.btnStop.setEnabled(True)
	#def _processStart

	def _processEnd(self,*args):
		self.cmbTools.setEnabled(True)
		self.btnStart.setEnabled(True)
		self.btnStop.setEnabled(False)
	#def _processEnd

	def _stopServer(self,*args):
		self.process.terminate()
		while self.process.state()!=QProcess.NotRunning:
			time.sleep(0.1)
			QApplication.processEvents()
	#def _stopServer

	def _initServer(self,mysqld,cmdArgs):
		initArgs=cmdArgs+["--initialize-insecure"]
		self.txtOutput.append("Init DB...")
		self.process.start(mysqld,initArgs)
		while self.process.state()!=QProcess.NotRunning:
			QApplication.processEvents()
			time.sleep(0.1)
		self.process.terminate()
		self.process.waitForFinished()
	#def _initServer

	def _chkMySqlInitialized(self,dataDir):
		init=True
		if os.path.exists(dataDir)==False:
			os.makedirs(dataDir)
		init=0
		for f in os.scandir(dataDir):
			if f.name=="ibdata1":
				init+=1
			if f.name=="mysql":
				init+=1
		if init<2:
			init=False
		return(init)
	#def _chkMySqlInitialized

	def _runServer(self,*args):
		binDir=_getBinDir()
		mysqld="{}/mysqld".format(binDir)
		dataDir=_getDataDir()
		cmdArgs=["--datadir",dataDir,"--persisted-globals-load"]
		if os.path.exists(mysqld):
			if self._chkMySqlInitialized(dataDir)==False:
				self._initServer(mysqld,cmdArgs)
			self.process.start(mysqld,cmdArgs)
	#def _runServer

def _getBinDir(*args):
	binDir=""
	for f in os.scandir("/opt"):
		if f.name.startswith("mysql") and f.name.endswith("minimal"):
			if os.path.exists(os.path.join(f.path,"bin")):
				binDir=os.path.join(f.path,"bin")
				break
	return(binDir)
#def _getBinDir

def _getDataDir(*args):
	try:
		dataDir=os.path.join(os.environ["HOME"],".local","share","mysql","datadir")
		if os.path.exists(dataDir)==False:
			os.makedirs(dataDir)
	except:
		dataDir=""
	return (dataDir)
#def _getDataDir(*args):


def _getCmdFromArgs(*args):
	cmd=os.path.basename(sys.argv[0])
	return(cmd)
#def _getCmdFromArgs

cmd=_getCmdFromArgs()
if cmd=="mysqlrun":
	app=QApplication(["MySQL"])
	if os.path.islink(__file__)==True:
		abspath=os.path.join(os.path.dirname(__file__),os.path.dirname(os.readlink(__file__)))
	else:
		abspath=os.path.dirname(__file__)
	mw=mysqlManager()
	mw.setMinimumWidth(mw.sizeHint().width()*1.6)
	mw.setMinimumHeight(mw.sizeHint().width()*0.9)
	mw.show()
	if hasattr(app,"exec"):
		sys.exit(app.exec())
	else:
		sys.exit(app.exec_())
else:
	pargs=sys.argv
	cmd=os.path.basename(pargs[0])
	binDir=_getBinDir()
	cmd="{0}/{1}".format(binDir,cmd)
	dataDir=_getDataDir()
	extendedArgs=list(set(pargs))
	extendedArgs.extend(["--datadir={}".format(dataDir)])
	pid=os.fork()
	if pid==0:
		os.execlp("/bin/sh","/bin/sh","-c","{0} {1} --console 2>&1| grep -vi datadir".format(cmd," ".join(extendedArgs)))
	else:
		p, status = os.waitpid(pid, 0)
		if os.WIFEXITED(status) and os.WEXITSTATUS(status) != 0:
			os.execvp(cmd,pargs)
