class mysqlManager(QMainWindow):
	def __init__(self):
		super().__init__()
		self.setWindowTitle("MySQL Manager")
		self.text_edit = QTextEdit()
		self.text_edit.setReadOnly(True)
		self.start_button = QPushButton("Start Command")
		self.start_button.clicked.connect(self.start_command)
		self.process = QProcess(self)
		self.process.readyReadStandardOutput.connect(self._readOutput)
		self.process.finished.connect(self._processEnd)
		wdg=self._renderGui()
		self.setCentralWidget(wdg)
	#def __init__(self):

	def _renderGui(self,*args):
		wdg=QWidget()
		lay=QGridLayout(wdg)
		self.txtOutput=QTextEdit()
		self.txtOutput.setReadOnly(True)
		lay.addWidget(self.txtOutput,0,0,1,2)
		btnStop=QPushButton(_("Stop"))
		icn=QIcon.fromTheme("process-stop")
		btnStop.setIcon(icn)
		btnStop.clicked.connect(self._stopServer)
		lay.addWidget(btnStop,1,0,1,1)
		btnStart=QPushButton(_("Start"))
		btnStart.clicked.connect(self._runServer)
		icn=QIcon.fromTheme("system-run")
		btnStart.setIcon(icn)
		lay.addWidget(btnStart,1,1,1,1)
		btnWrk=QPushButton(_("Workbench"))
		lay.addWidget(btnWrk,2,0,1,2)
		return(wdg)
	#def _renderGui

	def _readOutput(self):
		output = self.process.readAllStandardOutput().data().decode()
		self.txtOutput.append(output)
	#def _readOutput

	def _processEnd(self,*args):
		pass

	def _stopServer(self,*args):
		binDir=_getBinDir()
		if binDir!="":
			pass
	#def _stopServer

	def _chkMySqlInitialized(self,dataDir):
		init=True
		if os.path.exists(dataDir)==False:
			os.path.makedirs(dataDir)
		init=0
		for f in os.scandir(dataDir):
			print(f.name)
			if f.name=="ibdata1":
				init+=1
			if f.name=="mysql":
				init+=1
		if init<2:
			init=False
		return(init)
	#def _chkMySqlInitialized
	
	def _runServer(self,*args):
		binDir=_getBinDir()
		dataDir=_getDataDir()
		if binDir!="":
			mysqld="{}/mysqld".format(binDir)
			cmdArgs=["--datadir",dataDir]
			if self._chkMySqlInitialized(dataDir)==False:
				initArgs=cmdArgs+["--initialize-insecure"]
				self.process.start(mysqld,initArgs)
			self.process.start(mysqld,cmdArgs)
	#def _runServer

	def start_command(self):
		# Replace with your command
		self.process.start("ping", ["-c", "100", "google.com"])

	def read_output(self):
		output = self.process.readAllStandardOutput().data().decode()
		self.text_edit.append(output)

	def process_finished(self):
		self.text_edit.append("Command finished!")

def _getBinDir(*args):
	binDir=""
	for f in os.scandir("/opt"):
		if f.name.startswith("mysql") and f.name.endswith("minimal"):
			if os.path.exists(os.path.join(f.path,"bin")):
				binDir=os.path.join(f.path,"bin")
				break
	return(binDir)
#def _getBinDir

def _getDataDir(*args):
	try:
		dataDir=os.path.join(os.environ["HOME"],".local","share","mysql","datadir")
	except:
		dataDir=""
	return (dataDir)
#def _getDataDir(*args):


def _getCmdFromArgs(*args):
	cmd=os.path.basename(sys.argv[0])
	return(cmd)
